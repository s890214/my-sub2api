+// subtractInactiveFile removes reclaimable inactive page cache from a cgroup v2
+// memory.current reading so the reported usage matches `docker stats` and
+// reflects memory pressure instead of file cache warmed by image/data reads.
+func subtractInactiveFile(used uint64, statPath string) uint64 {
+	raw, err := os.ReadFile(statPath)
+	if err != nil {
+		return used
+	}
+	for _, line := range strings.Split(string(raw), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) != 2 || fields[0] != "inactive_file" {
+			continue
+		}
+		inactive, err := strconv.ParseUint(fields[1], 10, 64)
+		if err != nil || inactive >= used {
+			return used
+		}
+		return used - inactive
+	}
+	return used
+}
