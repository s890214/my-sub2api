+// TestSubtractInactiveFile covers the docker-stats parity fix: cgroup v2
+// memory.current includes reclaimable inactive page cache, which must not be
+// reported as process usage.
+func TestSubtractInactiveFile(t *testing.T) {
+	dir := t.TempDir()
+	statPath := filepath.Join(dir, "memory.stat")
+
+	require.NoError(t, os.WriteFile(statPath,
+		[]byte("anon 100\ninactive_file 4096\nactive_file 8\n"), 0o600))
+	require.Equal(t, uint64(4096), subtractInactiveFile(8192, statPath))
+
+	// Missing file / malformed stat: fall back to the raw reading.
+	require.Equal(t, uint64(8192), subtractInactiveFile(8192, filepath.Join(dir, "missing")))
+	require.NoError(t, os.WriteFile(statPath, []byte("inactive_file 999999\n"), 0o600))
+	require.Equal(t, uint64(8192), subtractInactiveFile(8192, statPath))
+}
